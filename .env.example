# Copiá este archivo a .env y completá los valores
# URL del proyecto en Supabase (Settings → API)
VITE_SUPABASE_URL=
# anon key (pública por diseño; la protección real la dan las políticas RLS)
VITE_SUPABASE_ANON_KEY=
# Base de la carta del cliente (para los QR de mesa y la redirección).
# Ejemplo: https://carta.tudominio.com
VITE_CARTA_URL=